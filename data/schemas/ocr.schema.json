{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OcrDatasetItem",
  "type": "object",
  "required": ["id", "title", "expectedText", "expectedEntities"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "imagePath": { "type": "string" },
    "mockOcrRaw": { "type": "string" },
    "expectedText": { "type": "string" },
    "expectedEntities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": { "type": "string" },
          "value": { "type": "string" },
          "bbox": {
            "type": "object",
            "properties": {
              "x0": { "type": "number" },
              "y0": { "type": "number" },
              "x1": { "type": "number" },
              "y1": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
