{
  "manifest_version": 3,
  "name": "SecureGPT — LLM Data Protection",
  "version": "1.2.2",
  "description": "Prevent leaks into generative tools. Detect and mask PII, secrets, and confidential information on major platforms.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "SecureGPT"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.openai.com/*",
        "https://*.chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://www.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://*.claude.ai/*",
        "https://*.perplexity.ai/*",
        "https://*.meta.ai/*",
        "https://poe.com/*",
        "https://*.mistral.ai/*",
        "https://*.cursor.com/*",
        "https://*.cursor.sh/*",
        "https://v0.dev/*",
        "https://replit.com/*",
        "https://huggingface.co/chat/*",
        "https://*.deepseek.com/*",
        "https://www.phind.com/*",
        "https://www.notion.so/*",
        "https://app.jasper.ai/*",
        "https://app.copy.ai/*"
      ],
      "js": [
        "content/index.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "https://*.openai.com/*",
    "https://*.chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://www.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://*.claude.ai/*",
    "https://*.perplexity.ai/*",
    "https://*.meta.ai/*",
    "https://poe.com/*",
    "https://*.mistral.ai/*",
    "https://*.cursor.com/*",
    "https://*.cursor.sh/*",
    "https://v0.dev/*",
    "https://replit.com/*",
    "https://huggingface.co/chat/*",
    "https://*.deepseek.com/*",
    "https://www.phind.com/*",
    "https://www.notion.so/*",
    "https://app.jasper.ai/*",
    "https://app.copy.ai/*",
    "https://accounts.google.com/*",
    "https://securegpt.rkavach.com/*",
    "https://api.securegpt.rkavach.com/*",
    "http://localhost:3000/*",
    "http://localhost:8000/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/offscreen/offscreen.html",
        "offscreen/*",
        "assets/*",
        "models/*",
        "wasm/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
