{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["chrome", "vite/client"],
    "paths": {
      "@securegpt/shared": ["../shared/src/index.ts"],
      "@securegpt/shared/*": ["../shared/src/*"],
      "@securegpt/detection": ["../detection/src/pipeline.ts"],
      "@securegpt/ocr": ["../ocr/src/index.ts"],
      "@securegpt/ocr/*": ["../ocr/src/*"],
      "@securegpt/regex": ["../regex/src/index.ts"],
      "@securegpt/ner": ["../ner/src/index.ts"],
      "@securegpt/shared/tier": ["../shared/src/tier.ts"],
      "@/*": ["./src/*"]
    },
    "allowJs": true
  },
  "include": ["src/**/*", "tests/**/*", "build.mjs"],
  "exclude": ["node_modules", "dist"]
}
