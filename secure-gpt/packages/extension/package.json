{
  "name": "@securegpt/extension",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "description": "SecureGPT Chrome Extension — DLP for LLM platforms",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "node build.mjs --mode=development",
    "build:dev": "node build.mjs --mode=development",
    "build:prod": "node build.mjs --mode=production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@firecrawl/anydoc-wasm": "^0.1.7",
    "@securegpt/detection": "*",
    "@securegpt/shared": "*",
    "axios": "^1.7.2",
    "clsx": "^2.1.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/chrome": "^0.0.268",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "happy-dom": "^20.8.9",
    "postcss": "^8.4.38",
    "tailwindcss": "^4",
    "typescript": "^5.4.5",
    "vite": "^5.2.12",
    "vitest": "^1.6.0"
  }
}
