# ─────────────────────────────────────────────
# SecureGPT Backend — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
APP_NAME=SecureGPT
APP_ENV=development               # development | staging | production
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-secret-key-min-32-chars-change-this-in-production

# ── Server ───────────────────────────────────
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,chrome-extension://*

# ── Database ─────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/securegpt
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Auth / JWT ───────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google OAuth ─────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Email (SendGrid) ─────────────────────────
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@securegpt.app
EMAIL_FROM_NAME=SecureGPT

# ── Security ─────────────────────────────────
BCRYPT_ROUNDS=12
LOG_RETENTION_DAYS=90

# ── High-risk alert threshold ────────────────
HIGH_RISK_BLOCK_THRESHOLD=5
HIGH_RISK_WINDOW_DAYS=7

# ── AWS (production) ─────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=securegpt-reports
