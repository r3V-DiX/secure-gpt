# ─────────────────────────────────────────────
# SecureGPT — Root .gitignore
# ─────────────────────────────────────────────

# ── Node ────────────────────────────────────
node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js

# ── Build outputs ────────────────────────────
dist/
dist-chrome/
dist-firefox/
build/
.next/
out/
.turbo/

# ── Environment files ─────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ── Python ───────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
ENV/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.egg

# ── ML model files ────────────────────────────
packages/detection/src/models/**/*.onnx
packages/detection/src/models/**/*.bin
packages/extension/public/ocr/eng.traineddata
packages/extension/public/ocr/eng.traineddata.gz
packages/extension/public/ocr/tesseract-core.wasm

# ── Database ─────────────────────────────────
*.db
*.sqlite
*.sqlite3
test.db

# ── Logs ─────────────────────────────────────
*.log
logs/
npm-debug.log*

# ── OS ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── IDE ──────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ── TypeScript ───────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── Test coverage ────────────────────────────
coverage/
lcov.info

# ── Misc ─────────────────────────────────────
*.pem
.vercel
.netlify
