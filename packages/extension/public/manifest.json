{
  "manifest_version": 3,
  "name": "SecureGPT — LLM Data Protection",
  "version": "1.0.0",
  "description": "Prevent data leaks into AI tools. Detect and mask PII, secrets, and confidential data in ChatGPT, Gemini, Claude, and more.",

  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "SecureGPT"
  },

  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.openai.com/*",
        "https://*.chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://*.claude.ai/*",
        "https://*.perplexity.ai/*",
        "https://*.meta.ai/*"
      ],
      "js": ["content/index.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "permissions": ["storage", "tabs", "offscreen", "alarms"],

  "host_permissions": [
    "https://*.openai.com/*",
    "https://*.chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://*.claude.ai/*",
    "https://*.perplexity.ai/*",
    "https://*.meta.ai/*",
    "https://accounts.google.com/*",
    "https://securegpt.rkavach.com/*",
    "https://api.securegpt.rkavach.com/*",
    "http://localhost:8000/*",
    "http://localhost:3000/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "src/offscreen/offscreen.html",
        "offscreen/*",
        "assets/*",
        "models/*",
        "wasm/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}