{
  "manifest_version": 3,
  "name": "SecureGPT — LLM Data Protection",
  "version": "1.0.0",
  "description": "Prevent sensitive data leaks into AI tools. Detects and blocks PII, credentials, and confidential data before it reaches ChatGPT, Gemini, Claude, and more.",

  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "SecureGPT"
  },

  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://claude.ai/*",
        "https://perplexity.ai/*",
        "https://meta.ai/*"
      ],
      "js": ["content/index.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "offscreen",
    "tabs"
  ],

  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://claude.ai/*",
    "https://perplexity.ai/*",
    "https://meta.ai/*",
    "https://accounts.google.com/*",
    "http://localhost:8000/*",
    "http://localhost:3000/*"
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "offscreen.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}