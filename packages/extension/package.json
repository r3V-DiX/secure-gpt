{
  "name": "@securegpt/extension",
  "version": "1.0.0",
  "description": "SecureGPT Chrome Extension — DLP for LLM platforms",
  "private": true,
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "node build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@securegpt/shared": "*",
    "@securegpt/detection": "*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "axios": "^1.7.2",
    "uuid": "^9.0.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.2.12",
    "vitest": "^1.6.0"
  }
}
